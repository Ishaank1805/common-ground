# Copy to .env (never commit .env); docker compose reads it automatically.
GEMINI_API_KEY=
# Set to 1 whenever the app is served over HTTPS (Secure, __Host- session cookies).
SECURE_COOKIES=
# Set to 0 to stop offering experimental voice matching. Participants choose to try it in Account.
VOICE_MATCHING=
# Optional. Admins choose who sees anonymous insights in the app (Account, Team access); usernames here also get access.
INSIGHT_VIEWERS=
# Set to 0 to stop offering instant prompts (Gemini Live). Participants choose them per conversation.
LIVE_PROMPTS=
